# Staging environment — dev.opitacode.com
# Points to the DEV Lambda stack (not production).
# Build with: vite build --mode staging

# ─── AWS Backend (Dev Stack) ─────────────────────────────
# Direct Lambda function URL (for Vite SST integration)
VITE_AWS_API_URL=https://glq73amln2ir72qplhrvcvkqne0tyddo.lambda-url.us-east-1.on.aws/

# ─── API Gateway (Dev) ───────────────────────────────────
# IMPORTANT: Must point to api-dev, NOT api.opitacode.com.
# api.opitacode.com does NOT allow CORS from dev.opitacode.com.
VITE_API_URL=https://api-dev.opitacode.com
VITE_BACKEND_URL=https://api-dev.opitacode.com

# ─── Per-service URLs (derived from VITE_API_URL) ────────
# Explicitly set to avoid falling back to prod hardcoded defaults.
VITE_CHAT_API_URL=https://api-dev.opitacode.com/chat/
VITE_STORAGE_API_URL=https://api-dev.opitacode.com/storage/
VITE_BILLING_API_URL=https://api-dev.opitacode.com/billing/
VITE_EVENTS_API_URL=https://api-dev.opitacode.com/core/events/ingest
VITE_MCP_API_URL=https://api-dev.opitacode.com/chat/mcp
